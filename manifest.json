{
  "manifest_version": 3,
  "name": "Squeek Keeper",
  "short_name": "Squeek Keeper",
  "version": "2.0.2",
  "description": "Alerts for your Squeeks: get pinged when they can merge, when SQK is ready to claim, and when Squeektoshi starts running.",
  "icons": {
    "16": "icons/idle-16.png",
    "32": "icons/idle-32.png",
    "48": "icons/idle-48.png",
    "128": "icons/idle-128.png"
  },
  "action": {
    "default_title": "Squeek Keeper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/idle-16.png",
      "32": "icons/idle-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://api.squeekchain.com/*"
  ]
}
